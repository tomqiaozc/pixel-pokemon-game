{
  "random": {
    "name": "Random",
    "description": "Selects moves at random with no strategy.",
    "difficulty": "easy",
    "used_by": ["wild_pokemon"],
    "behavior": {
      "move_selection": "random",
      "switch_threshold": null,
      "item_usage": false
    }
  },
  "basic": {
    "name": "Basic",
    "description": "Prefers super-effective moves but otherwise random.",
    "difficulty": "easy",
    "used_by": ["youngster", "lass", "bug_catcher"],
    "behavior": {
      "move_selection": "prefer_super_effective",
      "switch_threshold": null,
      "item_usage": false,
      "super_effective_weight": 2.0
    }
  },
  "defensive": {
    "name": "Defensive",
    "description": "Prioritizes healing and status moves when HP is low.",
    "difficulty": "medium",
    "used_by": ["hiker", "beauty", "gentleman"],
    "behavior": {
      "move_selection": "defensive_priority",
      "heal_threshold_percent": 30,
      "prefer_status_moves": true,
      "switch_threshold": null,
      "item_usage": true,
      "item_heal_threshold_percent": 25
    }
  },
  "aggressive": {
    "name": "Aggressive",
    "description": "Always picks highest damage move, ignores survivability.",
    "difficulty": "medium",
    "used_by": ["blackbelt", "biker", "tamer"],
    "behavior": {
      "move_selection": "max_damage",
      "switch_threshold": null,
      "item_usage": false,
      "ignore_accuracy": false
    }
  },
  "smart": {
    "name": "Smart",
    "description": "Considers type matchups, stat stages, and switches strategically.",
    "difficulty": "hard",
    "used_by": ["ace_trainer", "psychic_trainer", "scientist"],
    "behavior": {
      "move_selection": "weighted_evaluation",
      "switch_threshold_percent": 20,
      "switch_on_disadvantage": true,
      "item_usage": true,
      "item_heal_threshold_percent": 30,
      "consider_stat_moves": true,
      "stat_move_turn_limit": 3,
      "weights": {
        "damage": 1.0,
        "type_advantage": 1.5,
        "stab_bonus": 1.2,
        "accuracy": 0.8,
        "status_value": 0.6
      }
    }
  },
