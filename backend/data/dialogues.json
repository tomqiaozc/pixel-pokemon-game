{
  "prof_oak_intro": {
    "id": "prof_oak_intro",
    "nodes": [
      {
        "id": "start",
        "text": "Hello there! Welcome to the world of Pokemon!",
        "next": "intro2"
      },
      {
        "id": "intro2",
        "text": "My name is Oak. People call me the Pokemon Professor.",
        "next": "intro3"
      },
      {
        "id": "intro3",
        "text": "This world is inhabited by creatures called Pokemon!",
        "next": "intro4"
      },
      {
        "id": "intro4",
        "text": "For some people, Pokemon are pets. Others use them for fights.",
        "next": "intro5"
      },
      {
        "id": "intro5",
        "text": "Myself... I study Pokemon as a profession.",
        "next": "choose_starter"
      },
      {
        "id": "choose_starter",
        "text": "Now, which Pokemon would you like to start with?",
        "choices": [
          {
            "label": "Bulbasaur",
            "next": "chose_bulbasaur"
          },
          {
            "label": "Charmander",
            "next": "chose_charmander"
          },
          {
            "label": "Squirtle",
            "next": "chose_squirtle"
          }
        ]
      },
      {
        "id": "chose_bulbasaur",
        "text": "Ah, Bulbasaur! An excellent choice! Take good care of it!",
        "action": {
          "type": "give_pokemon",
          "value": "1"
        },
        "next": null
      },
      {
        "id": "chose_charmander",
        "text": "Charmander, the fire type! A spirited choice!",
        "action": {
          "type": "give_pokemon",
          "value": "4"
        },
        "next": null
      },
      {
        "id": "chose_squirtle",
        "text": "Squirtle! A fine Water-type Pokemon! Treat it well!",
        "action": {
          "type": "give_pokemon",
          "value": "7"
        },
        "next": null
      }
    ]
  },
